{
  "expo": {
    "name": "Fit Check",
    "slug": "fitcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitcheck",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fitcheckcloset.app",
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": { "backgroundColor": "#151311" }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fit Check uses your photos so you can add clothes to your closet and post outfits.",
          "cameraPermission": "Fit Check uses the camera so you can photograph your clothes and outfits.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
